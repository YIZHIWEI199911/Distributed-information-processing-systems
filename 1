import java.util.Scanner;
//Enter the radius r of the circle. Calculate the area (π * r ^ 2) and perimeter (2 * π * r) of a circle with this radius.
//输入圆的半径 r。计算以此半径为圆的面积 (π * r ^ 2) 和周长 (2 * π * r)。
// 类名改为Main，与文件名Main.java保持一致
public class Main {
    public static void main(String[] args) {
        // 创建Scanner对象用于接收用户输入
        Scanner scanner = new Scanner(System.in);

        try {
            // 提示用户输入半径
            System.out.print("Please enter the radius of the circle r: ");

            // 读取用户输入的半径
            double radius = scanner.nextDouble();

            // 检查半径是否为正数
            if (radius <= 0) {
                System.out.println("Error: Radius must be a positive number！");
                return;
            }

            // 计算面积：π * r²
            double area = Math.PI * radius * radius;

            // 计算周长：2 * π * r
            double perimeter = 2 * Math.PI * radius;

            // 输出结果，保留两位小数
            System.out.printf("The area of the circle is: %.2f%n", area);
            System.out.printf("The circumference of the circle is: %.2f%n", perimeter);
        } catch (Exception e) {
            // 处理输入非数字的情况
            System.out.println("Error: Please enter a valid number！");
        } finally {
            // 关闭Scanner
            scanner.close();
        }
    }
}
